# Site-specific configuration (credentials, SMTP, encryption keys)
config/config.php

# Live chat widget script (Smartsupp, Tawk.to, etc. — per-site API keys)
includes/livechat.php

# User/server uploads — live files stay on the server; git pull must not overwrite them
# (uploads/images/ is NOT ignored — static marketing assets for the public site stay in git)
uploads/kyc/*
!uploads/kyc/.htaccess
uploads/profile-pictures/*
!uploads/profile-pictures/index.php
uploads/profile-photos/*
!uploads/profile-photos/index.php
uploads/loans/*
!uploads/loans/.htaccess
!uploads/loans/index.php
uploads/documents/*
!uploads/documents/index.php
uploads/investments/*
!uploads/investments/.htaccess
uploads/profiles/*
!uploads/profiles/.htaccess

# Site branding (logo/favicon) — per-server; must survive git pull/deploy
uploads/branding/*
!uploads/branding/.htaccess
!uploads/branding/index.php

# Legacy branding paths (older uploads wrote into tracked code dirs)
assets/images/bank-logo.*
/favicon.ico
/favicon.png
/favicon.webp