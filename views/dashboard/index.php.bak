    font-size: 24px;
    flex-shrink: 0;
}

.checklist-details h4 {
    margin: 0 0 8px 0;
    font-size: 18px;
    color: #202124;
    font-weight: 600;
}

.checklist-details p {
    margin: 0 0 12px 0;
    font-size: 14px;
    color: #666;
}

.checklist-action {
    display: inline-block;
    padding: 8px 16px;
    background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
