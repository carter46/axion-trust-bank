                    foreach ($recentTransactions as $transaction) {
                        // Convert amount if user has different currency
                        $displayAmount = $transaction['amount'];
                        if ($needsConversion) {
                            $displayAmount = $currencyHelper->convert($transaction['amount'], $systemCurrency, $userCurrency);
                        }
                        
                        $amount = $displayAmount;
                        $isNegative = ($transaction['transaction_type'] === 'debit');
                        $amountClass = $isNegative ? 'amount-negative' : 'amount-positive';
                        $amountSign = $isNegative ? '-' : '+';
                        
                        // Get initials from description
                        $words = explode(' ', $transaction['description']);
                        $initials = '';
                        foreach ($words as $word) {
                            if (!empty($word)) {
                                $initials .= strtoupper(substr($word, 0, 1));
                                if (strlen($initials) >= 2) break;
                            }
                        }
                        if (strlen($initials) < 2) $initials = strtoupper(substr($transaction['description'], 0, 2));
                        
                        $avatarClass = $avatarColors[$colorIndex % 3];
                        $colorIndex++;
                        
                        $date = date('M d Y', strtotime($transaction['created_at']));
                ?>
                <div class="transaction-item" onclick="window.location.href='<?php echo SITE_URL; ?>/transaction?id=<?php echo $transaction['id']; ?>'" style="cursor: pointer;">
